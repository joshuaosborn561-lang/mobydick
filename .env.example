# Copy to .env. Never commit real keys.

# GetLeads (MCP + optional API key)
GETLEADS_API_KEY=
GETLEADS_ENDPOINT=https://app.getleads.io/api/mcp

# Email waterfall (Josh's Railway MCP)
EMAIL_WATERFALL_MCP_URL=https://email-waterfall-production-021b.up.railway.app/mcp
EMAIL_WATERFALL_CLIENT_TAG=salesglider

# LeadMagic (last email-waterfall tier, used to fill CSV gaps)
LEADMAGIC_API_KEY=
LEADMAGIC_ENDPOINT=https://api.leadmagic.io

# YouTube Data API v3
YOUTUBE_API_KEY=

# Taddy podcast GraphQL
TADDY_USER_ID=
TADDY_API_KEY=
TADDY_ENDPOINT=https://api.taddy.org

# Apify (only when public web is thin)
APIFY_API_KEY=
APIFY_ACTOR=harvestapi~linkedin-profile-posts

# Optional LLM for enrichment / gift reasoning
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# MCP transport: stdio (Cursor local) or streamable-http (Railway)
MCP_TRANSPORT=stdio
HOST=0.0.0.0
PORT=8000

# Persist root (exclude lists, CSVs, jobs)
MOBYDICK_DATA_DIR=data

# Optional. Signed CSV links use this, then GETLEADS_API_KEY, then LEADMAGIC_API_KEY.
# MOBYDICK_DOWNLOAD_SECRET=
# Optional public origin for download links. Railway sets RAILWAY_PUBLIC_DOMAIN.
# MOBYDICK_PUBLIC_URL=
