# Copy to .env. Never commit real keys.

# GetLeads (MCP + optional API key)
GETLEADS_API_KEY=
GETLEADS_ENDPOINT=https://app.getleads.io/api/mcp
# In-flight GetLeads calls. Default 2. Starts are also capped at 4/sec.
# GETLEADS_CONCURRENCY=2

# Parallel page/research workers. Default 8, cap 16. Set to 1 for sequential.
# ENRICH_WORKERS=8
# PIPELINE_WORKERS=8

# Email waterfall (Josh's Railway service). CSV fill uses POST /enrich-one.
EMAIL_WATERFALL_MCP_URL=https://email-waterfall-production-021b.up.railway.app/mcp
EMAIL_WATERFALL_CLIENT_TAG=salesglider
# Optional. Defaults are $0.25/person and $25/run. Leave unset on Railway.
# EMAIL_WATERFALL_APPROVE_COST_USD=0.25
# EMAIL_WATERFALL_RUN_CEILING_USD=25

# YouTube Data API v3
YOUTUBE_API_KEY=

# Taddy podcast GraphQL
TADDY_USER_ID=
TADDY_API_KEY=
TADDY_ENDPOINT=https://api.taddy.org

# Apify. LinkedIn posts (APIFY_ACTOR) and JS page rendering.
# Not used for Google search.
APIFY_API_KEY=
APIFY_ACTOR=harvestapi~linkedin-profile-posts

# Serper. Google search for PE bios and interviews.
# If SERPER_API_KEY is empty, research stays on the firm site plus YouTube and Taddy.
SERPER_API_KEY=

# PE life extraction. Set one of these on Railway. If both are empty, list jobs warn
# and stay on strict heuristics (empty fields instead of guessed bios).
# ANTHROPIC_API_KEY is used first. OPENAI_API_KEY is the fallback.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# MCP transport: stdio (Cursor local) or streamable-http (Railway)
MCP_TRANSPORT=stdio
HOST=0.0.0.0
PORT=8000

# Persist root (exclude lists, CSVs, jobs)
MOBYDICK_DATA_DIR=data

# Optional. Signed CSV links use this, then GETLEADS_API_KEY.
# A leftover LEADMAGIC_API_KEY still signs if present.
# MOBYDICK_DOWNLOAD_SECRET=
# Optional public origin for download links. Railway sets RAILWAY_PUBLIC_DOMAIN.
# MOBYDICK_PUBLIC_URL=
